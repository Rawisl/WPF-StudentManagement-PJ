<Window x:Class="WPF_StudentManagement_Project.Views.SuaHocSinhWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        SizeToContent="Height" Width="400" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        Background="White"
        WindowStyle="ToolWindow">

    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="Sửa thông tin học sinh" FontSize="22" FontWeight="Bold" Foreground="#FF1A237E" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <Label Content="Mã Học Sinh (Không được sửa):" FontWeight="SemiBold" FontSize="14" Foreground="Gray"/>
            <Border Background="#F5F5F5" CornerRadius="8" BorderBrush="#D2D6DC" BorderThickness="1" Margin="0,5,0,15" Height="38">
                <TextBox Text="{Binding MaHS}" BorderThickness="0" Background="Transparent" IsReadOnly="True" Foreground="Gray" VerticalContentAlignment="Center" Padding="10,0" FontSize="15"/>
            </Border>

            <Label Content="Họ Tên:" FontWeight="SemiBold" FontSize="14" Foreground="Gray"/>
            <Border Background="#F8F9FA" CornerRadius="8" BorderBrush="#D2D6DC" BorderThickness="1" Margin="0,5,0,15" Height="38">
                <TextBox x:Name="txtHoTen" Text="{Binding HoTen}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="15"/>
            </Border>

            <Label Content="Giới tính:" FontWeight="SemiBold" FontSize="14" Foreground="Gray"/>
            <Border Background="#F8F9FA" CornerRadius="8" BorderBrush="#D2D6DC" BorderThickness="1" Margin="0,5,0,15" Height="38">
                <ComboBox x:Name="cbGioiTinh" Text="{Binding GioiTinh}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="15">
                    <ComboBoxItem Content="Nam"/>
                    <ComboBoxItem Content="Nữ"/>
                </ComboBox>
            </Border>

            <Label Content="Ngày sinh (dd/MM/yyyy):" FontWeight="SemiBold" FontSize="14" Foreground="Gray"/>
            <Border Background="#F8F9FA" CornerRadius="8" BorderBrush="#D2D6DC" BorderThickness="1" Margin="0,5,0,25" Height="38">
                <TextBox x:Name="txtNgaySinh" Text="{Binding NgaySinh}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="15"/>
            </Border>

            <Button Content="Lưu Thay Đổi" Click="BtnLuu_Click" Height="45" Background="#FF270EDC" Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>