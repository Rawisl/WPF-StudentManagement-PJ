<UserControl x:Class="WPF_StudentManagement_Project.Views.LapDanhSachUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_StudentManagement_Project.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:WPF_StudentManagement_Project.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <viewmodels:DSLopViewModel/>
    </UserControl.DataContext>

    <Grid>
        <materialDesign:Card HorizontalAlignment="Left" Height="89" Margin="10,10,0,0" VerticalAlignment="Top" Width="774" BorderBrush="Black" BorderThickness="1" UniformCornerRadius="15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="0,0,0,15" Padding="15" 
                             BorderBrush="Black" BorderThickness="1" UniformCornerRadius="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding SiSoText}" Foreground="Black" FontSize="20" VerticalAlignment="Center" Margin="0,0,30,0"/>

                <TextBlock Text="{Binding SiSoText}" Foreground="Black" FontSize="20" VerticalAlignment="Center" Margin="0,0,30,0"/>

                <TextBlock Text="{Binding SiSoText}" Foreground="Black" FontSize="20" VerticalAlignment="Center" Margin="0,0,30,0"/>

                <Button Content="+ Thêm học sinh" 
        Command="{Binding AddStudentCommand}" 
        FontSize="16" Margin="90,0,0,0">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#FF270EDC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="LightGray"/>
                                    <Setter Property="Foreground" Value="DarkGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </materialDesign:Card>

        <DataGrid HorizontalAlignment="Center" Height="300" Margin="0,115,0,0" VerticalAlignment="Top" Width="774" 
                  ItemsSource="{Binding DanhSachLop}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50"/>
                <DataGridTextColumn Header="Mã HS" Binding="{Binding MaHS}" Width="100" Foreground="#FF0D55F3"/>
                <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="*"/>
                <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" Width="80"/>
                <DataGridTextColumn Header="Ngày Sinh" Binding="{Binding NgaySinh}" Width="120"/>

                <DataGridTemplateColumn Header="Thao Tác" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.XoaStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="✕" 
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="Red" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Width="30" Height="30"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>