<UserControl x:Class="WPF_StudentManagement_Project.Views.LapDanhSachUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_StudentManagement_Project.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="0,0,0,15" Padding="15" 
                             BorderBrush="Black" BorderThickness="1" UniformCornerRadius="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Khối:" FontSize="20" Foreground="Black" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" x:Name="ChonKhoiCB" Width="100" Height="32" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <Label Grid.Column="2" Content="Lớp:" FontSize="20" Foreground="Black" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="3" x:Name="ChonLopCB" Width="120" Height="32" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" x:Name="txtSiSo" Text="Sĩ số: 10" Foreground="Black" FontSize="20" VerticalAlignment="Center"/>

                <Button Grid.Column="6" x:Name="AddStudentButton" 
                        Content="+ Thêm học sinh" 
                        Click="AddStudentButton_Click" 
                        FontSize="16" 
                        Background="#FF270EDC" 
                        Foreground="White"
                        Padding="15,5">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </materialDesign:Card>

        <DataGrid Grid.Row="1" x:Name="dtgDanhSach" 
                  AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50"/>
                <DataGridTextColumn Header="Mã HS" Binding="{Binding MaHS}" Width="100" Foreground="#FF0D55F3"/>
                <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="*"/>
                <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" Width="80"/>
                <DataGridTextColumn Header="Ngày Sinh" Binding="{Binding NgaySinh}" Width="120"/>

                <DataGridTemplateColumn Header="Thao Tác" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnXoa" 
                                    Click="btnXoa_Click"
                                    Content="✕" 
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="Red" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Width="30" Height="30"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>